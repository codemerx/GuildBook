{
  "name": "@app/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:real-home": "node scripts/dev.ts --real-home",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "typecheck": "node scripts/typecheck.ts",
    "arch": "node scripts/arch.ts",
    "brand:check": "node scripts/brand-check.ts",
    "deps:check": "node scripts/deps-check.ts",
    "deps:audit": "node scripts/deps-audit.ts",
    "build:test": "pnpm --filter @app/desktop build:test",
    "build:prod": "pnpm --filter @app/desktop build:prod",
    "storybook": "pnpm --filter @app/desktop storybook"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "24.19.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
